# 环境变量配置示例（复制为 .env 后填入真实值；.env 永远不要提交到 Git）

# Anthropic API Key（必需）
ANTHROPIC_API_KEY=填入你的API密钥

# LLM 网关地址（可选，留空用 Anthropic 官方端点；用中转网关时填网关地址）
API_BASE_URL=

# LLM模型配置
LLM_MODEL=claude-sonnet-4-5-20250929

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 调试模式
DEBUG=false

# ===== 知乎黑客松 OAuth（从赛事页面领取后填入，留空则前端为演示模式） =====
# App ID / App Key 在知乎黑客松活动页面「创建项目」后领取
# ZHIHU_OAUTH_APP_ID=
# ZHIHU_OAUTH_APP_KEY=
# 正式提交时必须与赛事页面登记的回调地址完全一致（公网HTTPS），本地开发可留空自动推导
# ZHIHU_OAUTH_REDIRECT_URI=
# 数据开放平台 Access Secret（zhihu CLI / 用户数据接口用；仅做登录+基础信息时可不配）
# ZHIHU_ACCESS_SECRET=
